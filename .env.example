# Copy to .env for local dev:  cp .env.example .env
# Every value here is a local-only placeholder. Never commit .env.

# --- LLM ---
# anthropic | bedrock | ollama | fake
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
BEDROCK_REGION=us-east-1

# --- RAG (local ONNX models via fastembed; weights download into MODEL_CACHE_DIR) ---
# fastembed | fake
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# fastembed | fake | none (none disables reranking)
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_CACHE_DIR=.cache/models

# --- App database (docker compose service "postgres") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disputedesk
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disputedesk

# --- Langfuse (self-hosted, http://localhost:3000) ---
# Generate real values with: openssl rand -hex 32  (hex, not base64: the DB password goes into a URL)
LANGFUSE_DB_PASSWORD=change-me-langfuse-db
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_SALT=change-me-salt
LANGFUSE_HOST=http://localhost:3000
# Create a project in the Langfuse UI, then paste its API keys here (used from M6).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=disputedesk
